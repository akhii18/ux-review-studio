# Supabase PostgreSQL connection string (Prisma runtime)
DATABASE_URL="postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres?sslmode=require"
# Direct URL for migrations (use the direct database host or the Supabase pooler)
DIRECT_URL="postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres?sslmode=require"
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Azure OpenAI — required for AI review generation
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Supabase Storage — required for screenshot uploads
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=ux-review-assets
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=3600

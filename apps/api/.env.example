# Supabase PostgreSQL connection string (Prisma runtime)
DATABASE_URL="postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres?sslmode=require"
# Direct URL for migrations (use the direct database host or the Supabase pooler)
DIRECT_URL="postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres?sslmode=require"
PORT=4000
NODE_ENV=development
# JWT secret used to sign auth tokens
JWT_SECRET=replace-with-a-strong-random-secret
# Frontend URL used by the API for redirects and CORS-safe links
WEB_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Azure OpenAI — required for AI review generation. All review depths use this
# same endpoint/key; the backend routes by model name in code:
#   quick    -> gpt-4.1-mini
#   standard -> DeepSeek-V4-Pro
#   deep     -> gpt-5.5
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional: force Playwright to use an installed browser when capturing Figma
# prototypes. If omitted, the API tries local Chrome, local Edge, then bundled
# Chromium.
FIGMA_BROWSER_EXECUTABLE_PATH=C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe

# Optional smoke test helper used by npm run test:figma:capture and
# npm run test:figma:review.
FIGMA_TEST_URL=

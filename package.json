{
  "name": "uxm-copilot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "db:migrate": "turbo run db:migrate --filter=@uxm/api",
    "db:seed": "turbo run db:seed --filter=@uxm/api",
    "db:studio": "turbo run db:studio --filter=@uxm/api",
    "start": "tsx apps/agentic-ai/src/run.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.32.0",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/langgraph": "^1.3.6",
    "@langchain/openai": "^1.4.7",
    "dotenv": "^16.4.0",
    "openai": "^6.42.0",
    "sharp": "^0.35.1",
    "tesseract.js": "^6.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "npm@10.8.3",
  "engines": {
    "node": ">=20.0.0"
  }
}

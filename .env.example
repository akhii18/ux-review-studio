# ── Database ─────────────────────────────────────────────────────────────────
# Azure Database for PostgreSQL connection string (Prisma runtime)
DATABASE_URL="postgresql://postgres:[password]@[server-name].postgres.database.azure.com:5432/[database]?sslmode=require"
# Direct URL for migrations
DIRECT_URL="postgresql://postgres:[password]@[server-name].postgres.database.azure.com:5432/[database]?sslmode=require"

# ── API ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# CORS origin(s) for the Express API
CORS_ORIGIN=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
# Required for AI review generation pipeline
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Required for review asset uploads and signed AI input URLs
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME=ux-review-assets

//Dks2
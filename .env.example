# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma at runtime
DATABASE_URL="postgresql://<user>:<password>@<server-name>.postgres.database.azure.com:5432/<database>?sslmode=require"
# Direct URL used by Prisma migrations
DIRECT_URL="postgresql://<user>:<password>@<server-name>.postgres.database.azure.com:5432/<database>?sslmode=require"

# ── API ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# JWT secret used by the API for auth tokens
JWT_SECRET=replace-with-a-strong-random-secret
# CORS origin(s) for the Express API
CORS_ORIGIN=http://localhost:3000
# Frontend URL used by the API when building links and redirects
WEB_APP_URL=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
# Required for AI review generation pipeline. All review depths use this same
# endpoint/key; the backend routes by model name in code:
#   quick    -> gpt-4.1-mini
#   standard -> DeepSeek-V4-Pro
#   deep     -> gpt-5.5
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Azure Communication Services Email ──────────────────────────────────────
# Requires an ACS resource, connected Email Communication Service, and verified sender/domain.
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING="endpoint=https://<resource-name>.communication.azure.com/;accesskey=<access-key>"
AZURE_COMMUNICATION_EMAIL_SENDER_ADDRESS=DoNotReply@<verified-domain>

